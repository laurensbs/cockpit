{
  "name": "cockpit",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "electron:compile": "tsc -p electron",
    "electron:server": "next build && node scripts/standalone.mjs",
    "electron:start": "npm run electron:compile && electron .",
    "electron:build": "npm run electron:server && npm run electron:compile && electron-builder --win",
    "test:electron": "playwright test -c playwright.electron.config.ts",
    "electron:build:mac": "npm run electron:server && npm run electron:compile && electron-builder --mac"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "main": "dist-electron/main.js",
  "description": "Al je projecten en bedrijven op één plek, met Claude Code als marketingbrein.",
  "author": "Laurens Bos",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurensbs/cockpit.git"
  }
}
