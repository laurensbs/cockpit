# Database: Neon (or any Postgres). Without it the cockpit runs on a temporary in-memory database.
DATABASE_URL=

# Login: a long random secret, the owner's address(es), and a one-time code for claiming the cockpit.
BETTER_AUTH_SECRET=
OWNER_EMAILS=
OWNER_SETUP_CODE=

# GitHub: a fine-grained personal access token, read-only (Contents: Read-only).
GITHUB_TOKEN=

# Claude: your Anthropic API key and the hard monthly limit in US dollars.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=10

# The daily job (Vercel Cron sends it as a bearer token). Without it the job refuses to run.
CRON_SECRET=

# Optional: the Monday email to yourself, through Resend (EMAIL_FROM on a verified domain).
RESEND_API_KEY=
EMAIL_FROM=

# Optional: let the Monday job make the weekly focus with Claude (costs a few cents a week).
WEEKLY_AI=
