# Cockpit runs on your own computer. The app sets these itself; for `npm run dev` you can set them here.

# The token the app window uses to talk to the local server. Any long random string; "dev" when unset outside production.
# COCKPIT_TOKEN=

# Where the embedded database lives. Default: .pglite in this folder; "memory" keeps nothing.
# PGLITE_DIR=

# A read-only GitHub token while developing; in the app you set it under Instellingen.
# GITHUB_TOKEN=

# Fixed answers instead of GitHub, for tests and demos (the packaged app ignores this).
# GITHUB_FIXTURES=1

# Write the "Open in Claude Code" command to this file instead of opening a terminal (tests).
# COCKPIT_FAKE_TERMINAL=
