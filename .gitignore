# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (PGlite) and test output
/.pglite*/
/test-results/
/playwright-report/
/e2e/.results/
/shots/

# but keep the example
!.env.example

# electron
/dist-electron/
/release/

# Vitest JSON report (RTK)
.vitest/
# Local preview server (paths of this machine)
.claude/launch.json
